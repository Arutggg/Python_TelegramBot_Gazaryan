# Скопируйте файл в .env и заполните значения. .env не попадает в git.
TELEGRAM_BOT_TOKEN=123456789:ваш-токен-от-BotFather

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Адрес веб-приложения (ссылки на личный кабинет и выгрузку)
WEB_URL=http://localhost:8000

# Суперпользователь для админки: в Docker создаётся автоматически при первом запуске
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=замените-пароль

# База для запуска без Docker (python manage.py runserver / runbot)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calendar_bot
DB_USER=postgres
DB_PASSWORD=postgres

# База в Docker (docker compose). Можно не менять
POSTGRES_DB=calendar_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
